{
  "name": "csound-wasm-plugin-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:web": "vite",
    "dev:server": "bun --watch server/index.ts",
    "setup:sdk": "bun run scripts/extract-sdk.ts",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run server/index.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@csound/browser": "7.0.0-beta31",
    "@csound/wasm-bin": "7.0.0-beta21",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hlolli/codemirror-lang-csound": "1.0.0-alpha11",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
