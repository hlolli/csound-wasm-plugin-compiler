{
  "name": "csound-wasm-plugin-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "prepare:sdk": "bun run scripts/prepare-sdk.ts",
    "copy:notices": "bun run scripts/copy-notices.ts",
    "dev": "bun run prepare:sdk && vite",
    "build": "bun run prepare:sdk && bun run typecheck && vite build && bun run copy:notices",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "preview": "vite preview",
    "start": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@csound/browser": "7.0.0-beta31",
    "@csound/wasm-bin": "7.0.0-beta21",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hlolli/codemirror-lang-csound": "1.0.0-alpha11",
    "@lezer/highlight": "^1.2.3",
    "@yowasp/clang": "22.0.0-git20542-10",
    "codemirror": "^6.0.2",
    "pako": "2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pako": "2.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
